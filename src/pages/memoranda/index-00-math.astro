---
import BaseLayout from "../../layouts/BaseLayout.astro";

const allPosts = await Astro.glob("../posts/memo-math-*.md*");
const pageTitle = "メモ";
export const category ="数学";
---
<BaseLayout pageTitle={pageTitle}>
  <ul>
    <li>記事</li>
    <ul>
      {allPosts.filter(((post: any) => post.frontmatter.tags?.includes("メモ"))).map((post: any) => (
      <li>
        <a href={post.url}>
          {post.frontmatter.title}
          ［{post.frontmatter.pubDate.toString().slice(0, 10).replace(/-0?/g, "/")}］
        </a>
      </li>
    ))}
    </ul>

    <li>読書メモ</li>
    <ul>
      {allPosts.filter(((post: any) => post.frontmatter.tags?.includes("読書メモ"))).map((post: any) => (
      <li>
        <a href={post.url}>
          {post.frontmatter.title}
          ［{post.frontmatter.pubDate.toString().slice(0, 10).replace(/-0?/g, "/")}］
        </a>
      </li>
    ))}
    </ul>

    <li>興味があることごと（i. e. 積読）</li>
    <ul>
      {allPosts.filter(((post: any) => post.frontmatter.tags?.includes("興味"))).map((post: any) => (
      <li>
        <a href={post.url}>
          {post.frontmatter.title}
          ［{post.frontmatter.pubDate.toString().slice(0, 10).replace(/-0?/g, "/")}］
        </a>
      </li>
    ))}
    </ul>
  </ul>
</BaseLayout>