---
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  // 1. 取得元のパスを memoranda 配下のすべてのフォルダ (**) に変更
  const allPosts = Object.values(import.meta.glob(['../memoranda/**/*.{md,mdx}', '../cetera/**/*.{md,mdx}'], { eager: true }));
  
  // 2. tagsの抽出を flatMap とオプショナルチェーン (?.) でより安全に
  const uniqueTags = [...new Set(allPosts.flatMap((post: any) => post.frontmatter?.tags || []))];

  return uniqueTags.map((tag) => {
    // 3. フィルタリング時にも安全なアクセス (?.) を使用
    const filteredPosts = allPosts.filter((post: any) => post.frontmatter?.tags?.includes(tag));
    return {
      params: { tag },
      props: { posts: filteredPosts },
    };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<BaseLayout pageTitle="">
  <h1><p class="tag">{tag}</p></h1>
  <ul>
    {posts.map((post: any) => <li><a href={post.url}>{post.frontmatter.title}</a></li>)}
  </ul>
</BaseLayout>