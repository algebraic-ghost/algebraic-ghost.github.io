---
import BaseLayout from "../layouts/BaseLayout.astro";
const pageTitle = ""
---
<BaseLayout pageTitle={pageTitle}>
	<div class="indexquote">
		<div style="font-size: 2.5em;"><span style="white-space: nowrap;">Inga människoord</span> äro sanna.</div>
		<div style="text-align: right; font-size: 1.5em;">Pär Lagerkvist, <cite>Under Stjärnorna</cite></div>
	</div>
</BaseLayout>

<style>
	.indexquote {
		font-family: "Cormorant Garamond", palatino, serif;
  	margin-left: 0;
		margin-top: calc(40vh - 200px);
  	padding: 10pt;
	}
</style>

