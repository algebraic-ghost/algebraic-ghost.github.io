---
import BaseLayout from "../layouts/BaseLayout.astro";
const pageTitle = ""
---
<BaseLayout pageTitle={pageTitle}>



<div class="moon"></div>

	<div class="indexquote">
		<div style="font-size: 2.5em;"><span style="white-space: nowrap;">Inga människoord</span> äro sanna.</div>
		<div style="text-align: right; font-size: 1.5em;">Pär Lagerkvist, <span style="white-space: nowrap;"><cite>Under Stjärnorna</cite></span></div>
	</div>


</header>

</BaseLayout>

<style>
	.indexquote {
		font-family: "Cormorant Garamond", palatino, serif;
  	margin-left: 0;
		margin-top: calc(40vh - 200px);
  	padding: 10pt;
	}



@media screen and (max-width: 635px) {
  .moon {
    width:200px;
    height:50px;
    background-image: url("/public/images/spritesheet.png");
    background-repeat: no-repeat;
    background-position: 0 0;
    background-size: 200px 400px;
    image-rendering: pixelated;
    animation: moon-frames 8s steps(8) infinite;

    position: fixed; /* 自由な位置に配置する命令 */
    top: 90px;   /* 上からの距離（ロゴの高さに合わせて調整してください） */
    right: 0px; /* 右からの距離 */
    z-index: 70; /* 他の要素より上に表示させる（重なり順） */
  }

  @keyframes moon-frames {
  from {
    background-position: 0 0;
  }

  to {
    background-position: 0 -400px;
  }
}
}
</style>

