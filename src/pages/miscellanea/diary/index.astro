---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import fs from 'node:fs';

const allPosts = await Astro.glob("../diary/*.md*");
const pageTitle = "日記";

const postsWithStats = allPosts.map((post: any) => {
  const fileContent = fs.readFileSync(post.file, 'utf-8');
  const bodyOnly = fileContent.replace(/^---[\s\S]*?---\n/, '');
  let plainText = bodyOnly.replace(/\s+/g, '');
  const charCount = plainText.length;

  return {
    url: post.url,
    title: post.frontmatter.title,
    charCount: charCount
  };
});

const maxCount = Math.max(...postsWithStats.map(p => p.charCount));
const totalCount = postsWithStats.reduce((sum, p) => sum + p.charCount, 0);
---

<BaseLayout pageTitle={pageTitle}>
  <p>勿読！</p>

  <ul class="diary-list">
    {postsWithStats.map((post) => {
      const percentage = maxCount > 0 ? (post.charCount / maxCount) * 100 : 0;
      return (
        <li class="diary-item" style={`--percent: ${percentage}%;`}>
          <a href={post.url} class="diary-link">
            <span>{post.title}</span>
            <span class="char-count">[{post.charCount.toLocaleString()}]</span>
          </a>
        </li>
      );
    })}
  </ul>
  <p class="total-count">[{totalCount.toLocaleString()}]</p>
</BaseLayout>

<style>
  :root {
    --accent-line-color: rgba(100, 150, 220, 0.8);
  }

  .diary-list {
    list-style-type: none;
    padding-left: 1.5rem;
  }

  .diary-item {
    position: relative;
    margin-bottom: 0rem;
    margin-top: 0.3rem;
    padding-bottom: -0.2rem;
  }

  .diary-item::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    height: 2px;
    width: var(--percent);
    background: linear-gradient(to right, oklch(0.60 0.1 280), oklch(0.20 0.1 280));
    border-radius: 2px;
  }

  .diary-link {
    text-decoration: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: oklch(0.80 0.1 250);
  }

  /* 平常時は非表示 */
  .char-count {
    font-size: 0.85em;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  /* キーを押している間だけ表示 */
  body.key-held .char-count {
    opacity: 0.45;
  }

  .total-count {
    font-size: 0.85em;
    text-align: right;
    opacity: 0;
    transition: opacity 0.15s ease;
    margin-top: 0.4rem;
    color: oklch(0.80 0.1 250);
  }

  body.key-held .total-count {
    opacity: 0.45;
  }
</style>

<script>
  // ここを変えればトリガーキーを変更できます: 'Shift' / 'Alt' なども可
  const TRIGGER_KEY = 'Control';

  document.addEventListener('keydown', (e) => {
    if (e.key === TRIGGER_KEY) document.body.classList.add('key-held');
  });

  document.addEventListener('keyup', (e) => {
    if (e.key === TRIGGER_KEY) document.body.classList.remove('key-held');
  });

  // 別タブへ切り替えた際に Ctrl が押しっぱなしになるのを防ぐ
  window.addEventListener('blur', () => {
    document.body.classList.remove('key-held');
  });
</script>
