---
import BaseLayout from "../../layouts/BaseLayout.astro";

const allPosts = await Astro.glob("../diary/*.md*");
const pageTitle = "日記";
---
<BaseLayout pageTitle={pageTitle}>
  全く推敲していない文章です．勿読！（内容にはたくさんの誤りなどが含まれると思います．ご指摘やご意見は歓迎いたします）
  <ul>{allPosts.map((post: any) => <li><a href={post.url}>{post.frontmatter.title}</a></li>)}</ul>
</BaseLayout>