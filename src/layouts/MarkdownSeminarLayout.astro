---
import BaseLayout from "./BaseLayout.astro";
import abcjs from "abcjs";
import 'abcjs/abcjs-audio.css';
const { frontmatter } = Astro.props;
---
<head>
  <meta charset="UTF-8" />
</head>

<BaseLayout pageTitle={frontmatter.title}>
  <slot />
</BaseLayout>

{!frontmatter.showToc && (
  <style is:global>
    .toc { display: none; }
  </style>
)}