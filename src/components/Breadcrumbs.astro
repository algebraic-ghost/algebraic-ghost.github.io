---
// src/components/Breadcrumbs.astro

const pathname = Astro.url.pathname;
const paths = pathname.split('/').filter((path) => path !== '');

// 1. pages ディレクトリ内のすべてのページ（astro, md, mdx）の情報を取得
const allPages = await Astro.glob('/src/pages/**/*.{astro,md,mdx}');

// 2. [URLパス : 表示名] のマップを自動作成
const pageLabels: Record<string, string> = {};

allPages.forEach((page) => {
  if (page.url) {
    // URLの末尾のスラッシュを消して統一（例: "/blog/" -> "/blog"）
    const cleanUrl = page.url.replace(/\/$/, '');
    
    // frontmatter の breadcrumb、なければ title を取得
    const label = page.frontmatter?.breadcrumb || page.frontmatter?.title;
    
    if (label) {
      pageLabels[cleanUrl] = label;
    }
  }
});
---

{paths.length > 0 && (
  <nav aria-label="Breadcrumb" class="breadcrumbs">
    <ol>
      <li>
        <a href="/">home</a>
      </li>

      {paths.map((path, index) => {
        // 現在の階層までのURLを合成（例: "/blog" や "/blog/my-post"）
        const href = `/${paths.slice(0, index + 1).join('/')}`;
        const isLast = index === paths.length - 1;

        // 3. マップにあればそれを、なければファイル名（path）を表示
        const label = pageLabels[href] || path;

        return (
          <li aria-current={isLast ? "page" : undefined}>
            <span class="separator" aria-hidden="true">/</span>
            {isLast ? (
              <span class="current-page">{label}</span>
            ) : (
              <a href={href}>{label}</a>
            )}
          </li>
        );
      })}
    </ol>
  </nav>
)}


<style>
  /* 基本的なスタイリング（お好みで調整してください） */
  .breadcrumbs {
    font-size: 0.9rem;
    padding: 1rem 0;
  }
  .breadcrumbs ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
  }
  .breadcrumbs li {
    display: flex;
    align-items: center;
  }
  .separator {
    margin: 0 0.5rem;
    color: #888;
  }
  .current-page {
    font-weight: bold;
  }
  a:hover {
    text-decoration: underline;
  }
</style>